{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "ThoughtProof"
  ],
  "name": "thoughtproof-mcp",
  "description": "Pre-action verification gate: verify before pay/trade/write/deploy. Hero tools verify_before_action / verify_decision; execute true only on ALLOW.",
  "type": "mcp_server",
  "status": "stable",
  "framework": "@modelcontextprotocol/sdk",
  "tools": 5,
  "transport": [
    "stdio"
  ],
  "keywords": [
    "verification",
    "ai-safety",
    "reasoning",
    "multi-model",
    "adversarial",
    "trust",
    "decision-verification",
    "mcp-server",
    "x402",
    "erc-8183",
    "base",
    "pre-action-gate",
    "verify-before-action",
    "fail-closed",
    "dql",
    "sentinel"
  ],
  "features": {
    "adversarial_verification": {
      "enabled": true,
      "note": "4 LLMs challenge each claim independently"
    },
    "trust_scores": {
      "enabled": true,
      "note": "Agent trust score lookup via ERC-8004"
    },
    "x402_payment": {
      "enabled": true,
      "note": "Pay-per-verification via USDC on Base"
    }
  }
}

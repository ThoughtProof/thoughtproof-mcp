{
  "name": "thoughtproof-mcp",
  "version": "0.4.0-dev",
  "description": "MCP server for ThoughtProof \u2014 verify AI reasoning with adversarial multi-model consensus",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "thoughtproof-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test test/*.test.js",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "thoughtproof",
    "verification",
    "ai-safety",
    "reasoning",
    "multi-model",
    "adversarial",
    "x402",
    "erc-8004",
    "decision-verification"
  ],
  "author": "ThoughtProof <raul@thoughtproof.ai>",
  "homepage": "https://thoughtproof.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThoughtProof/thoughtproof-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ThoughtProof/thoughtproof-mcp/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}

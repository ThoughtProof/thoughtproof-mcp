# Example environment for local MCP hosts.
# Copy values into the host connector env — do not commit real keys.

# Hero verify_decision (DQL path) — use dqlk_… only, never dqla_…
DQL_API_KEY=

# Optional: Sentinel path when mode=sentinel or auto-route picks Sentinel
SENTINEL_API_KEY=

# Optional: verify_claim / verify_trade / Sentinel fallback
THOUGHTPROOF_API_KEY=

# Optional: mark DQL sandbox only when intentional
# DQL_SANDBOX=1

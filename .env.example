# Example env for local MCP hosts. Do not commit real keys.
# Hero verify key uses prefix dqlk_ (not account token prefix dqla_).

DQL_API_KEY=
SENTINEL_API_KEY=
THOUGHTPROOF_API_KEY=
# DQL_SANDBOX=1

# Signed-export binding is required by default (fail-closed).
# Set to 0 only to trust an unsigned Sentinel verdict. That is not safe.
# TP_REQUIRE_SIGNED_BINDING=0
# Optional public export-key document (thoughtproof.keys.v1 JSON).
# Replaces the pinned public keys. Never put a private key or API key here.
# SENTINEL_EXPORT_KEYS_JSON=
